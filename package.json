{
  "name": "tatsumi-ss-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "share": "node scripts/share.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx tests/domain.test.ts",
    "test:db": "node --import tsx scripts/test-db.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests scripts next.config.ts playwright.config.ts package.json tsconfig.json vercel.json README.md",
    "format:check": "prettier --check src tests scripts next.config.ts playwright.config.ts package.json tsconfig.json vercel.json README.md"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "1.58.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
